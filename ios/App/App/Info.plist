<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Cooney's Truck Tracker</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Cooney's Trucking uses your location to show dispatch your truck's position on the live fleet map.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Cooney's Trucking tracks your truck's location during your shift, including while the app is in the background, so dispatch can see live fleet positions.</string>
	<!-- Job-completion photo (@capacitor/camera). Only the two strings the app
	     actually exercises are declared: it takes a new photo, or picks an
	     existing one. NSPhotoLibraryAddUsageDescription is deliberately NOT
	     here — the app never writes back to the camera roll (saveToGallery is
	     off), and declaring a permission you do not use invites an App Review
	     question with no upside. -->
	<key>NSCameraUsageDescription</key>
	<string>Cooney's Trucking lets you attach a photo of the load or the site when you mark a job complete.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Cooney's Trucking lets you attach an existing photo from your library when you mark a job complete.</string>
	<!-- Open in Maps (2026-10-12, migration 0013). The driver app no longer
	     routes anyone: it hands the destination to the driver's OWN maps app.
	     iOS only answers "is Google Maps / Waze / Apple Maps installed?"
	     (@capacitor/app-launcher canOpenUrl) for schemes declared here, so the
	     sheet can list just the apps that are really on the phone. Query only:
	     this grants nothing and needs no Apple capability or new profile. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>comgooglemaps</string>
		<string>waze</string>
		<string>maps</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
